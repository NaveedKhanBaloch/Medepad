# Copy this file and name the copy ".env". Never share or upload .env.

# PostgreSQL (local). Special characters in the password must be URL-encoded: @ -> %40, # -> %23
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/medepad_admin

# Secret used to sign logins. Make your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# The admin website's address
CORS_ORIGINS=http://localhost:3001

# First admin (made on first start when there are no admins). Change the password after signing in.
SEED_ADMIN_NAME=Medepad Admin
SEED_ADMIN_EMAIL=admin@medepad.local
SEED_ADMIN_PASSWORD=Admin@12345

# AI that writes the notes: gemini (free key: https://aistudio.google.com/apikey), openai, azure_openai or mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
